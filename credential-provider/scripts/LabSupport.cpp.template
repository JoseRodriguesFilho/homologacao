    constexpr wchar_t kRegPath[] = L"SOFTWARE\\e-GOV\\LabCPFProvider";
    constexpr wchar_t kPipePath[] = L"\\\\.\\pipe\\eGOVLabCPFAgent";
    constexpr size_t kMaxResponse = 32 * 1024;

    class HttpHandle
    {
    public:
        explicit HttpHandle(HINTERNET h = nullptr) : _h(h) {}
        ~HttpHandle()
        {
            if (_h != nullptr)
            {
                WinHttpCloseHandle(_h);
            }
        }

        operator HINTERNET() const { return _h; }
        bool valid() const { return _h != nullptr; }

        HttpHandle(const HttpHandle&) = delete;
        HttpHandle& operator=(const HttpHandle&) = delete;

    private:
        HINTERNET _h;
    };

    bool ReadRegString(PCWSTR valueName, std::wstring& value)
    {
        HKEY key = nullptr;

        LONG status = RegOpenKeyExW(
            HKEY_LOCAL_MACHINE,
            kRegPath,
            0,
            KEY_QUERY_VALUE | KEY_WOW64_64KEY,
            &key);

        if (status != ERROR_SUCCESS)
        {
            return false;
        }

        DWORD type = 0;
        DWORD cb = 0;

        status = RegQueryValueExW(
            key,
            valueName,
            nullptr,
            &type,
            nullptr,
            &cb);

        if (status != ERROR_SUCCESS ||
            (type != REG_SZ && type != REG_EXPAND_SZ) ||
            cb < sizeof(wchar_t))
        {
            RegCloseKey(key);
            return false;
        }

        std::vector<wchar_t> buffer(
            (cb / sizeof(wchar_t)) + 2,
            L'\0');

        status = RegQueryValueExW(
            key,
            valueName,
            nullptr,
            &type,
            reinterpret_cast<LPBYTE>(buffer.data()),
            &cb);

        RegCloseKey(key);

        if (status != ERROR_SUCCESS)
        {
            return false;
        }

        buffer.back() = L'\0';
        value.assign(buffer.data());

        return !value.empty();
    }

    DWORD ReadRegDword(PCWSTR valueName, DWORD defaultValue)
    {
        HKEY key = nullptr;

        LONG status = RegOpenKeyExW(
            HKEY_LOCAL_MACHINE,
            kRegPath,
            0,
            KEY_QUERY_VALUE | KEY_WOW64_64KEY,
            &key);

        if (status != ERROR_SUCCESS)
        {
            return defaultValue;
        }

        DWORD type = 0;
        DWORD data = 0;
        DWORD cb = sizeof(data);

        status = RegQueryValueExW(
            key,
            valueName,
            nullptr,
            &type,
            reinterpret_cast<LPBYTE>(&data),
            &cb);

        RegCloseKey(key);

        if (status != ERROR_SUCCESS || type != REG_DWORD)
        {
            return defaultValue;
        }

        return data;
    }

    bool ReadRegBinary(
        PCWSTR valueName,
        std::vector<BYTE>& data)
    {
        HKEY key = nullptr;

        LONG status = RegOpenKeyExW(
            HKEY_LOCAL_MACHINE,
            kRegPath,
            0,
            KEY_QUERY_VALUE | KEY_WOW64_64KEY,
            &key);

        if (status != ERROR_SUCCESS)
        {
            return false;
        }

        DWORD type = 0;
        DWORD cb = 0;

        status = RegQueryValueExW(
            key,
            valueName,
            nullptr,
            &type,
            nullptr,
            &cb);

        if (status != ERROR_SUCCESS ||
            type != REG_BINARY ||
            cb == 0)
        {
            RegCloseKey(key);
            return false;
        }

        data.resize(cb);

        status = RegQueryValueExW(
            key,
            valueName,
            nullptr,
            &type,
            data.data(),
            &cb);

        RegCloseKey(key);

        if (status != ERROR_SUCCESS)
        {
            data.clear();
            return false;
        }

        data.resize(cb);
        return true;
    }

    std::string WideToUtf8(const std::wstring& input)
    {
        if (input.empty())
        {
            return {};
        }

        int required = WideCharToMultiByte(
            CP_UTF8,
            WC_ERR_INVALID_CHARS,
            input.data(),
            static_cast<int>(input.size()),
            nullptr,
            0,
            nullptr,
            nullptr);

        if (required <= 0)
        {
            return {};
        }

        std::string output(
            static_cast<size_t>(required),
            '\0');

        if (WideCharToMultiByte(
                CP_UTF8,
                WC_ERR_INVALID_CHARS,
                input.data(),
                static_cast<int>(input.size()),
                output.data(),
                required,
                nullptr,
                nullptr) <= 0)
        {
            return {};
        }

        return output;
    }

    std::wstring Utf8ToWide(const std::string& input)
    {
        if (input.empty())
        {
            return {};
        }

        int required = MultiByteToWideChar(
            CP_UTF8,
            MB_ERR_INVALID_CHARS,
            input.data(),
            static_cast<int>(input.size()),
            nullptr,
            0);

        if (required <= 0)
        {
            return {};
        }

        std::wstring output(
            static_cast<size_t>(required),
            L'\0');

        if (MultiByteToWideChar(
                CP_UTF8,
                MB_ERR_INVALID_CHARS,
                input.data(),
                static_cast<int>(input.size()),
                output.data(),
                required) <= 0)
        {
            return {};
        }

        return output;
    }

    std::string EscapeJson(const std::string& input)
    {
        std::string output;
        output.reserve(input.size() + 16);

        for (unsigned char ch : input)
        {
            switch (ch)
            {
            case '\\': output += "\\\\"; break;
            case '"': output += "\\\""; break;
            case '\b': output += "\\b"; break;
            case '\f': output += "\\f"; break;
            case '\n': output += "\\n"; break;
            case '\r': output += "\\r"; break;
            case '\t': output += "\\t"; break;
            default:
                if (ch >= 0x20)
                {
                    output.push_back(static_cast<char>(ch));
                }
                break;
            }
        }

        return output;
    }

    std::wstring ComputerName()
    {
