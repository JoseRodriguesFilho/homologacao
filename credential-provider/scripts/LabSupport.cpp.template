    class HttpHandle
    {
    public:
        explicit HttpHandle(HINTERNET h = nullptr) : _h(h) {}
        ~HttpHandle()
        {
            if (_h != nullptr)
            {
                WinHttpCloseHandle(_h);
            }
        }

        operator HINTERNET() const { return _h; }
        bool valid() const { return _h != nullptr; }

        HttpHandle(const HttpHandle&) = delete;
        HttpHandle& operator=(const HttpHandle&) = delete;

    private:
        HINTERNET _h;
    };

    bool ReadRegString(PCWSTR valueName, std::wstring& value)
    {
        HKEY key = nullptr;

        LONG status = RegOpenKeyExW(
            HKEY_LOCAL_MACHINE,
            kRegPath,
            0,
            KEY_QUERY_VALUE | KEY_WOW64_64KEY,
            &key);

        if (status != ERROR_SUCCESS)
        {
            return false;
        }

        DWORD type = 0;
        DWORD cb = 0;

        status = RegQueryValueExW(
            key,
            valueName,
            nullptr,
            &type,
            nullptr,
            &cb);

        if (status != ERROR_SUCCESS ||
            (type != REG_SZ && type != REG_EXPAND_SZ) ||
            cb < sizeof(wchar_t))
        {
            RegCloseKey(key);
            return false;
        }

        std::vector<wchar_t> buffer(
            (cb / sizeof(wchar_t)) + 2,
            L'\0');

        status = RegQueryValueExW(
            key,
            valueName,
            nullptr,
            &type,
            reinterpret_cast<LPBYTE>(buffer.data()),
            &cb);

        RegCloseKey(key);

        if (status != ERROR_SUCCESS)
        {
            return false;
        }

        buffer.back() = L'\0';
        value.assign(buffer.data());

        return !value.empty();
    }

    DWORD ReadRegDword(PCWSTR valueName, DWORD defaultValue)
    {
        HKEY key = nullptr;

        LONG status = RegOpenKeyExW(
            HKEY_LOCAL_MACHINE,
            kRegPath,
            0,
            KEY_QUERY_VALUE | KEY_WOW64_64KEY,
            &key);

        if (status != ERROR_SUCCESS)
        {
            return defaultValue;
        }

        DWORD type = 0;
        DWORD data = 0;
        DWORD cb = sizeof(data);

        status = RegQueryValueExW(
            key,
            valueName,
            nullptr,
            &type,
            reinterpret_cast<LPBYTE>(&data),
            &cb);

        RegCloseKey(key);

        if (status != ERROR_SUCCESS || type != REG_DWORD)
        {
            return defaultValue;
        }

        return data;
    }

    bool ReadRegQword(PCWSTR valueName, ULONGLONG& value)
    {
        value = 0;
        HKEY key = nullptr;

        LONG status = RegOpenKeyExW(
            HKEY_LOCAL_MACHINE,
            kRegPath,
            0,
            KEY_QUERY_VALUE | KEY_WOW64_64KEY,
            &key);

        if (status != ERROR_SUCCESS)
        {
            return false;
        }

        DWORD type = 0;
        DWORD cb = sizeof(value);

        status = RegQueryValueExW(
            key,
            valueName,
            nullptr,
            &type,
            reinterpret_cast<LPBYTE>(&value),
            &cb);

        RegCloseKey(key);
        return status == ERROR_SUCCESS &&
               type == REG_QWORD &&
               cb == sizeof(value);
    }

    bool ReadRegBinary(
        PCWSTR valueName,
        std::vector<BYTE>& data)
    {
        HKEY key = nullptr;

        LONG status = RegOpenKeyExW(
            HKEY_LOCAL_MACHINE,
            kRegPath,
            0,
            KEY_QUERY_VALUE | KEY_WOW64_64KEY,
            &key);

        if (status != ERROR_SUCCESS)
        {
            return false;
        }

        DWORD type = 0;
        DWORD cb = 0;

        status = RegQueryValueExW(
            key,
            valueName,
            nullptr,
            &type,
            nullptr,
            &cb);

        if (status != ERROR_SUCCESS ||
            type != REG_BINARY ||
            cb == 0)
        {
            RegCloseKey(key);
            return false;
        }

        data.resize(cb);

        status = RegQueryValueExW(
            key,
            valueName,
            nullptr,
            &type,
            data.data(),
            &cb);

        RegCloseKey(key);

        if (status != ERROR_SUCCESS)
        {
            data.clear();
            return false;
        }

        data.resize(cb);
        return true;
    }

    bool ReadProtectedString(
        PCWSTR valueName,
        std::wstring& value)
    {
        value.clear();
        std::vector<BYTE> encrypted;

        if (!ReadRegBinary(valueName, encrypted))
        {
            return false;
        }

        DATA_BLOB input = {};
        input.pbData = encrypted.data();
        input.cbData = static_cast<DWORD>(encrypted.size());
        DATA_BLOB output = {};

        if (!CryptUnprotectData(
                &input,
                nullptr,
                nullptr,
                nullptr,
                nullptr,
                CRYPTPROTECT_UI_FORBIDDEN,
                &output))
        {
            SecureZeroMemory(encrypted.data(), encrypted.size());
            return false;
        }

        bool ok = false;

        if (output.pbData != nullptr &&
            output.cbData >= sizeof(wchar_t))
        {
            size_t chars = output.cbData / sizeof(wchar_t);
            const wchar_t* raw =
                reinterpret_cast<const wchar_t*>(output.pbData);

            while (chars > 0 && raw[chars - 1] == L'\0')
            {
                --chars;
            }

            value.assign(raw, chars);
            ok = !value.empty();
            SecureZeroMemory(output.pbData, output.cbData);
        }

        if (output.pbData != nullptr)
        {
            LocalFree(output.pbData);
        }

        SecureZeroMemory(encrypted.data(), encrypted.size());
        return ok;
    }

    bool HasUsableIpv4()
    {
        ULONG size = 16 * 1024;
        std::vector<BYTE> buffer(size);
        auto* addresses =
            reinterpret_cast<PIP_ADAPTER_ADDRESSES>(buffer.data());

        ULONG result = GetAdaptersAddresses(
            AF_INET,
            GAA_FLAG_SKIP_ANYCAST |
                GAA_FLAG_SKIP_MULTICAST |
                GAA_FLAG_SKIP_DNS_SERVER,
            nullptr,
            addresses,
            &size);

        if (result == ERROR_BUFFER_OVERFLOW)
        {
            buffer.resize(size);
            addresses =
                reinterpret_cast<PIP_ADAPTER_ADDRESSES>(buffer.data());
            result = GetAdaptersAddresses(
                AF_INET,
                GAA_FLAG_SKIP_ANYCAST |
                    GAA_FLAG_SKIP_MULTICAST |
                    GAA_FLAG_SKIP_DNS_SERVER,
                nullptr,
                addresses,
                &size);
        }

        if (result != NO_ERROR)
        {
            return false;
        }

        for (auto* adapter = addresses;
             adapter != nullptr;
             adapter = adapter->Next)
        {
            if (adapter->OperStatus != IfOperStatusUp ||
                adapter->IfType == IF_TYPE_SOFTWARE_LOOPBACK ||
                adapter->IfType == IF_TYPE_TUNNEL)
            {
                continue;
            }

            for (auto* unicast = adapter->FirstUnicastAddress;
                 unicast != nullptr;
                 unicast = unicast->Next)
            {
                if (unicast->Address.lpSockaddr == nullptr ||
                    unicast->Address.lpSockaddr->sa_family != AF_INET)
                {
                    continue;
                }

                const auto* ipv4 =
                    reinterpret_cast<const sockaddr_in*>(
                        unicast->Address.lpSockaddr);
                const auto* octets =
                    reinterpret_cast<const BYTE*>(&ipv4->sin_addr);

                if (octets[0] != 0 &&
                    octets[0] != 127 &&
                    !(octets[0] == 169 && octets[1] == 254))
                {
                    return true;
                }
            }
        }

        return false;
    }

    LAB_AUTH_RESULT ClassifyWinHttpFailure(DWORD error)
    {
        switch (error)
        {
        case ERROR_WINHTTP_TIMEOUT:
        case ERROR_WINHTTP_NAME_NOT_RESOLVED:
        case ERROR_WINHTTP_CANNOT_CONNECT:
        case ERROR_WINHTTP_CONNECTION_ERROR:
            return LAB_AUTH_API_UNREACHABLE;

        default:
            // Falha de certificado, parametro, memoria ou outra condicao
            // interna nao prova que a API esteja fora. Falha fechada.
            return LAB_AUTH_DENIED;
        }
    }

    std::string WideToUtf8(const std::wstring& input)
    {
        if (input.empty())
        {
            return {};
        }

        int required = WideCharToMultiByte(
            CP_UTF8,
            WC_ERR_INVALID_CHARS,
            input.data(),
            static_cast<int>(input.size()),
            nullptr,
            0,
            nullptr,
            nullptr);

        if (required <= 0)
        {
            return {};
        }

        std::string output(
            static_cast<size_t>(required),
            '\0');

        if (WideCharToMultiByte(
                CP_UTF8,
                WC_ERR_INVALID_CHARS,
                input.data(),
                static_cast<int>(input.size()),
                output.data(),
                required,
                nullptr,
                nullptr) <= 0)
        {
            return {};
        }

        return output;
    }

    std::wstring Utf8ToWide(const std::string& input)
    {
        if (input.empty())
        {
            return {};
        }

        int required = MultiByteToWideChar(
            CP_UTF8,
            MB_ERR_INVALID_CHARS,
            input.data(),
            static_cast<int>(input.size()),
            nullptr,
            0);

        if (required <= 0)
        {
            return {};
        }

        std::wstring output(
            static_cast<size_t>(required),
            L'\0');

        if (MultiByteToWideChar(
                CP_UTF8,
                MB_ERR_INVALID_CHARS,
                input.data(),
                static_cast<int>(input.size()),
                output.data(),
                required) <= 0)
        {
            return {};
        }

        return output;
    }

    std::string EscapeJson(const std::string& input)
    {
        std::string output;
        output.reserve(input.size() + 16);

        for (unsigned char ch : input)
        {
            switch (ch)
            {
            case '\\': output += "\\\\"; break;
            case '"': output += "\\\""; break;
            case '\b': output += "\\b"; break;
            case '\f': output += "\\f"; break;
            case '\n': output += "\\n"; break;
            case '\r': output += "\\r"; break;
            case '\t': output += "\\t"; break;
            default:
                if (ch >= 0x20)
                {
                    output.push_back(static_cast<char>(ch));
                }
                break;
            }
        }

        return output;
    }

