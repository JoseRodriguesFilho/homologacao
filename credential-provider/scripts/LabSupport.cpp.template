    bool JsonBool(
        const std::string& json,
        const std::string& key,
        bool defaultValue)
    {
        const std::string marker = "\"" + key + "\"";
        size_t pos = json.find(marker);

        if (pos == std::string::npos)
        {
            return defaultValue;
        }

        pos = json.find(':', pos + marker.size());

        if (pos == std::string::npos)
        {
            return defaultValue;
        }

        ++pos;

        while (pos < json.size() &&
               std::isspace(
                   static_cast<unsigned char>(json[pos])))
        {
            ++pos;
        }

        if (json.compare(pos, 4, "true") == 0)
        {
            return true;
        }

        if (json.compare(pos, 5, "false") == 0)
        {
            return false;
        }

        return defaultValue;
    }

    bool AppendUnicodeEscape(
        const std::string& json,
        size_t& pos,
        std::wstring& output)
    {
        if (pos + 4 > json.size())
        {
            return false;
        }

        unsigned value = 0;

        for (int i = 0; i < 4; ++i)
        {
            char ch = json[pos++];

            value <<= 4;

            if (ch >= '0' && ch <= '9')
            {
                value |= static_cast<unsigned>(ch - '0');
            }
            else if (ch >= 'a' && ch <= 'f')
            {
                value |= static_cast<unsigned>(ch - 'a' + 10);
            }
            else if (ch >= 'A' && ch <= 'F')
            {
                value |= static_cast<unsigned>(ch - 'A' + 10);
            }
            else
            {
                return false;
            }
        }

        output.push_back(static_cast<wchar_t>(value));
        return true;
    }

    std::wstring JsonString(
        const std::string& json,
        const std::string& key)
    {
        const std::string marker = "\"" + key + "\"";
        size_t pos = json.find(marker);

        if (pos == std::string::npos)
        {
            return {};
        }

        pos = json.find(':', pos + marker.size());

        if (pos == std::string::npos)
        {
            return {};
        }

        ++pos;

        while (pos < json.size() &&
               std::isspace(
                   static_cast<unsigned char>(json[pos])))
        {
            ++pos;
        }

        if (json.compare(pos, 4, "null") == 0)
        {
            return {};
        }

        if (pos >= json.size() || json[pos] != '"')
        {
            return {};
        }

        ++pos;

        std::string utf8;
        std::wstring wideEscapes;

        // Primeiro decodifica os escapes simples mantendo UTF-8.
        while (pos < json.size())
        {
            char ch = json[pos++];

            if (ch == '"')
            {
                break;
            }

            if (ch != '\\')
            {
                utf8.push_back(ch);
                continue;
            }

            if (pos >= json.size())
            {
                break;
            }

            char esc = json[pos++];

            switch (esc)
            {
            case '"': utf8.push_back('"'); break;
            case '\\': utf8.push_back('\\'); break;
            case '/': utf8.push_back('/'); break;
            case 'b': utf8.push_back('\b'); break;
            case 'f': utf8.push_back('\f'); break;
            case 'n': utf8.push_back('\n'); break;
            case 'r': utf8.push_back('\r'); break;
            case 't': utf8.push_back('\t'); break;

            case 'u':
            {
                // Converte a parte UTF-8 acumulada e limpa.
                if (!utf8.empty())
                {
                    wideEscapes += Utf8ToWide(utf8);
                    utf8.clear();
                }

                if (!AppendUnicodeEscape(
                        json,
                        pos,
                        wideEscapes))
                {
                    return {};
                }

                break;
            }

            default:
                return {};
            }
        }

        if (!utf8.empty())
        {
            wideEscapes += Utf8ToWide(utf8);
        }

        return wideEscapes;
    }

    void ParseResponse(
        const std::string& json,
        LAB_AUTH_RESPONSE* response)
    {
        response->authorized = JsonBool(
            json,
            "authorized",
            false);

        response->recognized = JsonBool(
            json,
            "recognized",
            false);

        response->allowed = JsonBool(
            json,
            "allowed",
            false);

        response->maintenance = JsonBool(
            json,
            "maintenance",
            false);

        response->reason = JsonString(json, "reason");
        response->message = JsonString(json, "message");
        if (response->message.empty())
        {
            response->message = JsonString(json, "detail");
        }
        response->name = JsonString(json, "name");
        response->role = JsonString(json, "role");
        response->course = JsonString(json, "course");
        response->maintenanceMessage = JsonString(
            json,
            "maintenance_message");
        response->sessionId = JsonString(json, "session_id");
        response->action = JsonString(json, "action");
        response->windowsAccount = JsonString(
            json,
            "windows_account");
    }

    LAB_AUTH_RESULT PostJson(
        PCWSTR endpoint,
        PCWSTR identifier,
        bool univesp,
        bool adminTarget,
        LAB_AUTH_RESPONSE* response)
    {
        if (response == nullptr ||
            identifier == nullptr ||
            *identifier == L'\0')
        {
            return LAB_AUTH_DENIED;
        }

        *response = LAB_AUTH_RESPONSE{};

        std::wstring baseUrl;
        std::wstring token;

        if (!ReadRegString(L"ApiBaseUrl", baseUrl) ||
            !ReadRegString(L"ApiToken", token))
        {
            return LAB_AUTH_NOT_CONFIGURED;
        }

        if (!HasUsableIpv4())
        {
            return LAB_AUTH_NETWORK_NOT_READY;
        }

        while (!baseUrl.empty() &&
               baseUrl.back() == L'/')
        {
            baseUrl.pop_back();
        }

        std::wstring url = baseUrl + endpoint;

        URL_COMPONENTS components = {};
        components.dwStructSize = sizeof(components);
        components.dwSchemeLength = static_cast<DWORD>(-1);
        components.dwHostNameLength = static_cast<DWORD>(-1);
        components.dwUrlPathLength = static_cast<DWORD>(-1);
        components.dwExtraInfoLength = static_cast<DWORD>(-1);

        if (!WinHttpCrackUrl(
                url.c_str(),
                0,
                0,
                &components))
        {
            return LAB_AUTH_NOT_CONFIGURED;
        }

        if (components.nScheme != INTERNET_SCHEME_HTTPS &&
            components.nScheme != INTERNET_SCHEME_HTTP)
        {
            return LAB_AUTH_NOT_CONFIGURED;
        }

        if (components.nScheme == INTERNET_SCHEME_HTTP &&
            ReadRegDword(L"AllowHttp", 0) != 1)
        {
            return LAB_AUTH_NOT_CONFIGURED;
        }

        std::wstring host(
            components.lpszHostName,
            components.dwHostNameLength);

        std::wstring path;

        if (components.dwUrlPathLength > 0)
        {
            path.assign(
                components.lpszUrlPath,
                components.dwUrlPathLength);
        }

        if (components.dwExtraInfoLength > 0)
        {
            path.append(
                components.lpszExtraInfo,
                components.dwExtraInfoLength);
        }

        if (path.empty())
        {
            path = L"/";
        }

        HttpHandle session(
            WinHttpOpen(
                L"eGOV-Login/11-homolog",
                WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY,
                WINHTTP_NO_PROXY_NAME,
                WINHTTP_NO_PROXY_BYPASS,
                0));

        if (!session.valid())
        {
            return ClassifyWinHttpFailure(GetLastError());
        }

        WinHttpSetTimeouts(
            session,
            1500,
            1500,
            2500,
            3000);

        HttpHandle connection(
            WinHttpConnect(
                session,
                host.c_str(),
                components.nPort,
                0));

        if (!connection.valid())
        {
            return ClassifyWinHttpFailure(GetLastError());
        }

        DWORD flags = 0;

        if (components.nScheme == INTERNET_SCHEME_HTTPS)
        {
            flags |= WINHTTP_FLAG_SECURE;
        }

        HttpHandle request(
            WinHttpOpenRequest(
                connection,
                L"POST",
                path.c_str(),
                nullptr,
                WINHTTP_NO_REFERER,
                WINHTTP_DEFAULT_ACCEPT_TYPES,
                flags));

        if (!request.valid())
        {
            return ClassifyWinHttpFailure(GetLastError());
        }

        std::string cpfUtf8 =
            WideToUtf8(identifier);

        std::string computerUtf8 =
            WideToUtf8(ComputerName());

        std::string target =
            adminTarget ? "admin" : "student";

        std::string institution = univesp ? "univesp" : "escola_governo";
        std::string identifierType = univesp ? "matricula" : "cpf";

        // Para CPF, envie também o campo legado "cpf". Assim a Escola de
        // Governo continua funcionando contra a API v10 enquanto a v11 e
        // implantada. A API v11 aceita os dois formatos.
        std::string legacyCpf = univesp
            ? ""
            : ",\"cpf\":\"" + EscapeJson(cpfUtf8) + "\"";

        std::string body =
            "{\"identifier\":\"" +
            EscapeJson(cpfUtf8) +
            "\",\"identifier_type\":\"" + identifierType +
            "\",\"institution\":\"" + institution +
            "\"" +
            legacyCpf +
            ",\"computer\":\"" +
            EscapeJson(computerUtf8) +
            "\",\"target\":\"" +
            target +
            "\"}";

        std::wstring headers =
            L"Content-Type: application/json\r\n"
            L"Accept: application/json\r\n"
            L"X-eGOV-Token: " +
            token +
            L"\r\n";

        BOOL sent = WinHttpSendRequest(
            request,
            headers.c_str(),
            static_cast<DWORD>(-1),
            reinterpret_cast<LPVOID>(
                const_cast<char*>(body.data())),
            static_cast<DWORD>(body.size()),
            static_cast<DWORD>(body.size()),
            0);

        if (!sent)
        {
            return ClassifyWinHttpFailure(GetLastError());
        }

        if (!WinHttpReceiveResponse(request, nullptr))
        {
            return ClassifyWinHttpFailure(GetLastError());
        }

        DWORD statusCode = 0;
        DWORD statusSize = sizeof(statusCode);

        if (!WinHttpQueryHeaders(
                request,
                WINHTTP_QUERY_STATUS_CODE |
                    WINHTTP_QUERY_FLAG_NUMBER,
                WINHTTP_HEADER_NAME_BY_INDEX,
                &statusCode,
                &statusSize,
                WINHTTP_NO_HEADER_INDEX))
        {
            return LAB_AUTH_DENIED;
        }

        std::string responseBody;

        while (true)
        {
            DWORD available = 0;

            if (!WinHttpQueryDataAvailable(
                    request,
                    &available))
            {
                return LAB_AUTH_DENIED;
            }

            if (available == 0)
            {
                break;
            }

            if (responseBody.size() + available >
                kMaxResponse)
            {
                return LAB_AUTH_DENIED;
            }

            size_t oldSize =
                responseBody.size();

            responseBody.resize(
                oldSize + available);

            DWORD read = 0;

            if (!WinHttpReadData(
                    request,
                    responseBody.data() + oldSize,
                    available,
                    &read))
            {
                return LAB_AUTH_DENIED;
            }

            responseBody.resize(
                oldSize + read);
        }

        ParseResponse(
            responseBody,
            response);

        // Le o JSON tambem nas respostas de erro para preservar a mensagem
        // especifica devolvida pela API. A classificacao continua fechada:
        // somente 5xx representa indisponibilidade elegivel a contingencia.
        if (statusCode == 401 ||
            statusCode == 403)
        {
            return LAB_AUTH_CLIENT_UNAUTHORIZED;
        }

        if (statusCode >= 500 && statusCode <= 599)
        {
            return LAB_AUTH_SERVICE_UNAVAILABLE;
        }

        if (statusCode != 200)
        {
            return LAB_AUTH_DENIED;
        }

        return LAB_AUTH_OK;
    }
}

bool LabCpfExtractDigits(
    PCWSTR input,
    wchar_t* digits11,
    size_t* digitCount,
    bool* invalidChars,
    size_t* excessDigits)
{
    if (digits11 == nullptr ||
        digitCount == nullptr ||
        invalidChars == nullptr ||
        excessDigits == nullptr)
    {
        return false;
    }

    digits11[0] = L'\0';
    *digitCount = 0;
    *invalidChars = false;
    *excessDigits = 0;

    if (input == nullptr)
    {
        return true;
    }

    size_t count = 0;
    size_t excess = 0;
    bool invalid = false;

    for (PCWSTR p = input; *p != L'\0'; ++p)
    {
        if (*p >= L'0' && *p <= L'9')
        {
            if (count < 11)
            {
                digits11[count++] = *p;
            }
            else
            {
                // 12o digito ou superior: excesso explicito.
                // Truncar em silencio autorizaria um CPF diferente do digitado.
                ++excess;
            }
        }
        else if (*p == L'.' ||
                 *p == L'-' ||
                 *p == L'/' ||
                 *p == L' ')
        {
            // Separadores comuns sao ignorados: colar 000.000.000-00 funciona.
            continue;
        }
        else
        {
            // Letras e demais simbolos invalidam a entrada.
            invalid = true;
        }
    }

    digits11[count] = L'\0';

    *digitCount = count;
    *invalidChars = invalid;
    *excessDigits = excess;

    return !invalid && excess == 0;
}

bool LabCpfCheckDigitsOk(
    PCWSTR digits11)
{
    if (digits11 == nullptr)
    {
        return false;
    }

    size_t length = 0;

    while (digits11[length] != L'\0')
    {
        if (digits11[length] < L'0' ||
            digits11[length] > L'9')
        {
            return false;
        }

        ++length;

        if (length > 11)
        {
            return false;
        }
    }

    if (length != 11)
    {
        return false;
    }

    bool allSame = true;

    for (size_t i = 1; i < 11; ++i)
    {
        if (digits11[i] != digits11[0])
        {
            allSame = false;
            break;
        }
    }

    if (allSame)
    {
        // Sequencias como 111.111.111-11 satisfazem o calculo, mas nao existem.
        return false;
    }

    for (int pos = 9; pos <= 10; ++pos)
    {
        int total = 0;
        const int weight = pos + 1;

        for (int i = 0; i < pos; ++i)
        {
            total += (digits11[i] - L'0') * (weight - i);
        }

        int digit = (total * 10) % 11;

        if (digit == 10)
        {
            digit = 0;
        }

        if (digit != (digits11[pos] - L'0'))
        {
            return false;
        }
    }

    return true;
}

bool LabMatriculaExtractDigits(
    PCWSTR input,
    wchar_t* digits32,
    size_t* digitCount,
    bool* invalidChars,
    size_t* excessDigits)
{
    if (!digits32 || !digitCount || !invalidChars || !excessDigits)
    {
        return false;
    }

    digits32[0] = L'\0';
    *digitCount = 0;
    *invalidChars = false;
    *excessDigits = 0;

    if (!input)
    {
        return true;
    }

    for (PCWSTR p = input; *p; ++p)
    {
        if (*p >= L'0' && *p <= L'9')
        {
            if (*digitCount < 32)
            {
                digits32[*digitCount] = *p;
                ++(*digitCount);
                digits32[*digitCount] = L'\0';
            }
            else
            {
                ++(*excessDigits);
            }
        }
        else
        {
            // Matricula UNIVESP e estritamente numerica, sem mascara.
            *invalidChars = true;
        }
    }

    return !*invalidChars && *excessDigits == 0;
}

LAB_AUTH_RESULT LabGetStatus(
    LAB_AUTH_RESPONSE* response)
{
    // Reutiliza o transporte autenticado; /status ignora o corpo da requisicao.
    return PostJson(
        L"/status",
        L"0",
        false,
        false,
        response);
}

LAB_AUTH_RESULT LabPreviewIdentity(
    PCWSTR identifier,
    bool univesp,
    bool adminTarget,
    LAB_AUTH_RESPONSE* response)
{
    return PostJson(
        L"/auth/preview",
        identifier,
        univesp,
        adminTarget,
        response);
}

LAB_AUTH_RESULT LabAuthorizeIdentity(
    PCWSTR identifier,
    bool univesp,
    bool adminTarget,
    LAB_AUTH_RESPONSE* response)
{
    // A v11 preserva a rota /auth/cpf para os dois tipos de identificação.
    // Assim não criamos uma segunda rota de autenticação e mantemos o
    // Credential Provider compatível com a API atual evoluída.
    PCWSTR authPath = L"/auth/cpf";

    LAB_AUTH_RESULT result = PostJson(
        authPath,
        identifier,
        univesp,
        adminTarget,
        response);

    if (result == LAB_AUTH_OK &&
        !response->authorized)
    {
        return LAB_AUTH_DENIED;
    }

    return result;
}

bool LabEmergencyCodeShapeOk(PCWSTR input)
{
    return IsEmergencyCodeCandidate(input);
}

LAB_EMERGENCY_RESULT LabTryEmergencyAccess(
    PCWSTR input,
    bool adminTarget,
    bool univesp,
    LAB_AUTH_RESPONSE* response)
{
    if (response == nullptr)
    {
        return LAB_EMERGENCY_NOT_APPLICABLE;
    }

    *response = LAB_AUTH_RESPONSE{};

    // A contingencia pertence exclusivamente ao perfil AlunoEGOV. Um valor
    // comum (CPF/matricula) continua seguindo sempre a autenticacao da API.
    if (adminTarget ||
        univesp ||
        !IsEmergencyCodeCandidate(input) ||
        ReadRegDword(L"EmergencyEnabled", 0) != 1)
    {
        return LAB_EMERGENCY_NOT_APPLICABLE;
    }

    std::wstring expectedCode;

    if (!ReadProtectedString(
            L"EmergencySecret",
            expectedCode))
    {
        return LAB_EMERGENCY_NOT_APPLICABLE;
    }

    const bool codeMatches =
        FixedTimeCodeEquals(input, expectedCode);
    SecureClear(expectedCode);

    // Nao revela na tela se um codigo de 12 digitos quase correspondeu ao
    // segredo. Se nao for o codigo configurado, ele segue como entrada normal.
    if (!codeMatches)
    {
        return LAB_EMERGENCY_NOT_APPLICABLE;
    }

    ULONGLONG expiresUnix = 0;

    if (!ReadRegQword(
            L"EmergencyExpiresUnix",
            expiresUnix) ||
        expiresUnix == 0 ||
        UnixTimeNow() >= expiresUnix)
    {
        response->message =
            L"Codigo de contingencia expirado. Procure a administracao.";
        return LAB_EMERGENCY_REJECTED;
    }

    LAB_AUTH_RESULT availability =
        LAB_AUTH_SERVICE_UNAVAILABLE;

    // O codigo nao ignora uma resposta da API. Ele so e liberado depois de
    // tres falhas de infraestrutura consecutivas, evitando um falso offline
    // enquanto a rede local ainda termina de subir.
    for (int attempt = 0;
         attempt < kEmergencyApiAttempts;
         ++attempt)
    {
        LAB_AUTH_RESPONSE statusResponse;
        availability = LabGetStatus(&statusResponse);

        if (!IsEmergencyEligibleFailure(availability))
        {
            if (availability == LAB_AUTH_CLIENT_UNAUTHORIZED)
            {
                response->message =
                    L"Este computador nao foi autorizado.";
            }
            else if (availability == LAB_AUTH_NOT_CONFIGURED)
            {
                response->message =
                    L"API de autenticacao nao configurada.";
            }
            else
            {
                response->message =
                    L"O codigo de contingencia so pode ser usado quando o servidor local estiver indisponivel.";
            }

            return LAB_EMERGENCY_REJECTED;
        }

        if (attempt + 1 < kEmergencyApiAttempts)
        {
            Sleep(kEmergencyRetryDelayMs);
        }
    }

    std::wstring displayName;
    std::wstring course;

    if (!ReadRegString(
            L"EmergencyDisplayName",
            displayName))
    {
        displayName = L"Aluno - Contingencia";
    }

    if (!ReadRegString(
            L"EmergencyCourse",
            course))
    {
        course = L"Aula em modo de contingencia";
    }

    response->authorized = true;
    response->recognized = true;
    response->allowed = true;
    response->reason = L"offline_emergency";
    response->message = L"Acesso emergencial autorizado.";
    response->name = displayName;
    response->role = L"aluno";
    response->course = course;
    response->action = L"offline_emergency";
    response->windowsAccount = L"AlunoEGOV";

    WriteEmergencyAudit();
    return LAB_EMERGENCY_AUTHORIZED;
}

bool LabReadLocalPassword(
    bool adminTarget,
    std::wstring& password)
{
    PCWSTR valueName =
        adminTarget
            ? L"AdminSecret"
            : L"StudentSecret";
    return ReadProtectedString(valueName, password);
}

void LabNotifyAgent(
    const LAB_AUTH_RESPONSE& response)
{
    if (!response.authorized ||
        response.sessionId.empty() ||
        response.windowsAccount.empty())
    {
        return;
    }

    HANDLE pipe = CreateFileW(
        kPipePath,
        GENERIC_WRITE,
        0,
        nullptr,
        OPEN_EXISTING,
        FILE_ATTRIBUTE_NORMAL,
        nullptr);

    if (pipe == INVALID_HANDLE_VALUE)
    {
        return;
    }

    std::string sessionId =
        EscapeJson(
            WideToUtf8(
                response.sessionId));

    std::string account =
        EscapeJson(
            WideToUtf8(
                response.windowsAccount));

    std::string role =
        EscapeJson(
            WideToUtf8(
                response.role));

    std::string action =
        EscapeJson(
            WideToUtf8(
                response.action));

    std::string payload =
        "{\"session_id\":\"" +
        sessionId +
        "\",\"windows_account\":\"" +
        account +
        "\",\"role\":\"" +
        role +
        "\",\"action\":\"" +
        action +
        "\"}";

    DWORD written = 0;

    WriteFile(
        pipe,
        payload.data(),
        static_cast<DWORD>(
            payload.size()),
        &written,
        nullptr);

    FlushFileBuffers(pipe);
    CloseHandle(pipe);
}

bool LabIsAccount(
    PCWSTR qualifiedUserName,
    PCWSTR leafAccountName)
{
    if (qualifiedUserName == nullptr ||
        leafAccountName == nullptr)
    {
        return false;
    }

    PCWSTR leaf =
        wcsrchr(
            qualifiedUserName,
            L'\\');

    if (leaf != nullptr)
    {
        ++leaf;
    }
    else
    {
        leaf = qualifiedUserName;
    }

    return _wcsicmp(
        leaf,
        leafAccountName) == 0;
}
