    ULONGLONG UnixTimeNow()
    {
        FILETIME fileTime = {};
        GetSystemTimeAsFileTime(&fileTime);

        ULARGE_INTEGER ticks = {};
        ticks.LowPart = fileTime.dwLowDateTime;
        ticks.HighPart = fileTime.dwHighDateTime;

        constexpr ULONGLONG kUnixEpochTicks = 116444736000000000ULL;
        constexpr ULONGLONG kTicksPerSecond = 10000000ULL;

        if (ticks.QuadPart <= kUnixEpochTicks)
        {
            return 0;
        }

        return (ticks.QuadPart - kUnixEpochTicks) / kTicksPerSecond;
    }

    void SecureClear(std::wstring& value)
    {
        if (!value.empty())
        {
            SecureZeroMemory(
                &value[0],
                value.size() * sizeof(wchar_t));
            value.clear();
        }
    }

    bool IsEmergencyCodeCandidate(PCWSTR input)
    {
        if (input == nullptr)
        {
            return false;
        }

        size_t count = 0;

        for (PCWSTR p = input; *p != L'\0'; ++p)
        {
            if (*p < L'0' || *p > L'9')
            {
                return false;
            }

            ++count;

            if (count > kEmergencyCodeDigits)
            {
                return false;
            }
        }

        return count == kEmergencyCodeDigits;
    }

    bool FixedTimeCodeEquals(
        PCWSTR input,
        const std::wstring& expected)
    {
        if (!IsEmergencyCodeCandidate(input) ||
            expected.size() != kEmergencyCodeDigits)
        {
            return false;
        }

        unsigned difference = 0;

        for (size_t i = 0; i < kEmergencyCodeDigits; ++i)
        {
            difference |= static_cast<unsigned>(
                input[i] ^ expected[i]);
        }

        return difference == 0;
    }

    void WriteEmergencyAudit()
    {
        wchar_t programData[MAX_PATH] = {};

        if (ExpandEnvironmentStringsW(
                L"%ProgramData%",
                programData,
                ARRAYSIZE(programData)) == 0)
        {
            return;
        }

        std::wstring vendorDir =
            std::wstring(programData) + L"\\e-GOV";
        std::wstring stateDir =
            vendorDir + L"\\LabCPF";

        CreateDirectoryW(vendorDir.c_str(), nullptr);
        CreateDirectoryW(stateDir.c_str(), nullptr);

        std::wstring logPath =
            stateDir + L"\\offline-access.log";
        HANDLE file = CreateFileW(
            logPath.c_str(),
            FILE_APPEND_DATA,
            FILE_SHARE_READ | FILE_SHARE_WRITE,
            nullptr,
            OPEN_ALWAYS,
            FILE_ATTRIBUTE_NORMAL,
            nullptr);

        if (file == INVALID_HANDLE_VALUE)
        {
            return;
        }

        SYSTEMTIME utc = {};
        GetSystemTime(&utc);
        wchar_t stamp[40] = {};
        swprintf_s(
            stamp,
            L"%04u-%02u-%02uT%02u:%02u:%02uZ",
            utc.wYear,
            utc.wMonth,
            utc.wDay,
            utc.wHour,
            utc.wMinute,
            utc.wSecond);

        std::wstring line =
            std::wstring(stamp) +
            L" computer=" + ComputerName() +
            L" action=offline_emergency\r\n";
        std::string utf8 = WideToUtf8(line);
        DWORD written = 0;

        if (!utf8.empty())
        {
            WriteFile(
                file,
                utf8.data(),
                static_cast<DWORD>(utf8.size()),
                &written,
                nullptr);
        }

        CloseHandle(file);
    }

